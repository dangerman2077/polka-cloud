#!/usr/bin/env bash
set -Eeuo pipefail

if (( EUID != 0 )); then
    echo 'Запустите команду с sudo: sudo polka ...' >&2
    exit 1
fi

usage() {
    cat <<'HELP'
Polka — управление облачным хранилищем

  sudo polka status                       состояние служб
  sudo polka logs                         последние записи журнала
  sudo polka restart                      перезапуск служб
  sudo polka account create USER          создать пользователя (случайный пароль)
  sudo polka account create USER --admin  создать администратора
  sudo polka account password USER        сменить пароль (случайный пароль)
  sudo polka account quota USER 5120      установить квоту 5120 МиБ (5 ГиБ)
  sudo polka check                        проверка Django
HELP
}

manage() {
    [[ -r /etc/polka.env ]] || { echo 'Polka не установлена.' >&2; exit 1; }
    # EnvironmentFile is root:polka 0640. Execute Django unprivileged.
    runuser -u polka -- /bin/bash -c '
        set -e
        set -a
        source /etc/polka.env
        set +a
        cd /opt/polka
        exec /opt/polka/.venv/bin/python manage.py "$@"
    ' polka-manage "$@"
}

case "${1:-}" in
    status) systemctl status polka-web polka-dav --no-pager ;;
    logs) journalctl -u polka-web -u polka-dav -n 100 --no-pager ;;
    restart) systemctl restart polka-web polka-dav && echo 'Polka перезапущена.' ;;
    account) shift; manage account "$@" ;;
    check) manage check ;;
    help|--help|-h|'') usage ;;
    *) echo "Неизвестная команда: $1" >&2; usage; exit 2 ;;
esac
