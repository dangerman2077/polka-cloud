# Template for local development or manual installation.
# install.sh creates /etc/polka.env automatically. Never commit real secrets.
POLKA_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
POLKA_ALLOWED_HOSTS=cloud.example.com
POLKA_CSRF_ORIGINS=https://cloud.example.com
POLKA_DATA_ROOT=/var/lib/polka
POLKA_DB_PATH=/var/lib/polka/db.sqlite3
POLKA_FORCE_SSL=1
POLKA_DEBUG=0
