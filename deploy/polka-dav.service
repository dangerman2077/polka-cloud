[Unit]
Description=Polka WebDAV server
After=network.target polka-web.service

[Service]
Type=simple
User=polka
Group=polka
WorkingDirectory=/opt/polka
EnvironmentFile=/etc/polka.env
UMask=0077
# One worker! WsgiDAV uses an in-memory lock manager; threads share it.
ExecStart=/opt/polka/.venv/bin/gunicorn --workers 1 --threads 8 --worker-class gthread --bind 127.0.0.1:18082 --timeout 300 dav_app:application
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/polka
PrivateTmp=true

[Install]
WantedBy=multi-user.target
